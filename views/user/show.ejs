<% layout("./layouts/boilerplate") %>
<div class="row g-4">
  <!-- Profile card -->
  <div class="col-md-4">
    <div class="card bg-secondary bg-opacity-10 border-secondary text-center p-4">
      <% if (user.image) { %>
        <img src="<%= user.image %>" class="rounded-circle mx-auto mb-3" style="width:100px;height:100px;object-fit:cover" alt="avatar">
      <% } else { %>
        <div class="rounded-circle bg-warning d-flex align-items-center justify-content-center mx-auto mb-3" style="width:100px;height:100px">
          <i class="bi bi-person-fill fs-1 text-dark"></i>
        </div>
      <% } %>
      <h4 class="text-warning"><%= user.username %></h4>
      <p class="text-secondary small mb-1"><i class="bi bi-envelope me-1"></i><%= user.email || '—' %></p>
      <p class="text-secondary small mb-1"><i class="bi bi-heart me-1"></i>Fav genre: <span class="text-light"><%= user.favgenre || 'none' %></span></p>
      <p class="text-secondary small mb-3"><i class="bi bi-translate me-1"></i>Pref language: <span class="text-light"><%= user.preflang || 'none' %></span></p>
      <div class="d-flex gap-2 justify-content-center flex-wrap">
        <a href="/account/edit" class="btn btn-sm btn-warning"><i class="bi bi-pencil me-1"></i>Edit Profile</a>
        <a href="/account/watchlist" class="btn btn-sm btn-outline-warning"><i class="bi bi-bookmark-heart me-1"></i>Watchlist</a>
        <a href="/account/comments" class="btn btn-sm btn-outline-secondary"><i class="bi bi-chat-dots me-1"></i>Comments</a>
      </div>
    </div>
  </div>

  <!-- Recommended movies -->
  <div class="col-md-8">
    <h5 class="text-warning mb-3"><i class="bi bi-collection-play me-2"></i>Recommended for you</h5>
    <% if (movies.length === 0) { %>
      <p class="text-secondary small">Set your favourite genre in <a href="/account/edit" class="text-warning">Edit Profile</a> to get recommendations.</p>
    <% } %>
    <div class="row row-cols-2 row-cols-md-3 g-3">
      <% for (let movie of movies) { %>
        <div class="col">
          <div class="card bg-secondary bg-opacity-10 border-secondary h-100">
            <% if (movie.images && movie.images.length > 0) { %>
              <img src="<%= movie.images[0].url %>" class="card-img-top" style="height:120px;object-fit:cover" alt="<%= movie.name %>">
            <% } %>
            <div class="card-body py-2 px-2">
              <p class="text-warning small mb-0 fw-bold"><%= movie.name %></p>
              <p class="text-secondary small mb-0"><i class="bi bi-star-fill me-1"></i><%= movie.rating || '—' %></p>
            </div>
            <div class="card-footer bg-transparent border-secondary p-1">
              <a href="/movies/<%= movie._id %>" class="btn btn-sm btn-warning w-100 py-0">Info</a>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>
