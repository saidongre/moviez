<% layout("./layouts/boilerplate") %>

  <!-- Header Section -->
  <div class="d-flex justify-content-between align-items-center mb-5 mt-4 gs-reveal">
    <h2 class="cinematic-heading text-white m-0" style="font-size: 2.5rem; letter-spacing: 2px;">
      <i class="bi bi-film me-2" style="color: var(--accent-primary);"></i> Trending <span
        style="color: var(--text-secondary);">Movies</span>
    </h2>
    <a href="/movies/filter" class="btn-cinematic-outline" style="padding: 8px 20px;">
      <i class="bi bi-funnel me-1"></i> Discover Filter
    </a>
  </div>

  <!-- Empty State -->
  <% if (movies.length===0) { %>
    <div class="text-center py-5 glass-panel gs-reveal">
      <i class="bi bi-camera-reels"
        style="font-size: 4rem; color: var(--text-muted); display: block; margin-bottom: 20px;"></i>
      <h3 class="cinematic-heading text-white">No Movies Found</h3>
      <p class="text-secondary mb-4">It's quiet in here... too quiet.</p>
      <% if (currentuser) { %>
        <a href="/movies/new" class="btn-cinematic">
          <i class="bi bi-plus-circle me-2"></i> Add First Movie
        </a>
        <% } %>
    </div>
    <% } %>

      <!-- Responsive Movie Grid -->
      <div class="movie-grid">
        <% for (let [index, movie] of movies.entries()) { %>
          <div class="movie-card-wrapper" data-aos="fade-up" data-aos-delay="<%= (index % 5) * 100 %>">
            <div class="movie-card">

              <!-- Poster Background -->
              <% if (movie.images && movie.images.length> 0) { %>
                <div class="movie-poster" style="background-image: url('<%= movie.images[0].url %>');"></div>
                <% } else { %>
                  <div class="movie-poster no-poster d-flex align-items-center justify-content-center">
                    <i class="bi bi-image" style="font-size: 3rem; color: var(--text-muted);"></i>
                  </div>
                  <% } %>

                    <!-- Hover Overlay -->
                    <div class="movie-overlay d-flex flex-column justify-content-end p-3">
                      <div class="movie-info-animate">
                        <h4 class="movie-title text-white fw-bold mb-1 text-truncate">
                          <%= movie.name %>
                        </h4>

                        <div class="d-flex gap-2 flex-wrap mb-2">
                          <span class="tag-pill">
                            <%= movie.genre %>
                          </span>
                          <% if(movie.year) { %><span class="tag-pill bg-dark">
                              <%= movie.year %>
                            </span>
                            <% } %>
                              <% if(movie.rating) { %>
                                <span class="tag-pill border border-warning text-warning bg-transparent">
                                  <i class="bi bi-star-fill me-1"></i>
                                  <%= movie.rating %>
                                </span>
                                <% } %>
                        </div>

                        <p class="movie-desc small text-light text-truncate" style="opacity: 0.8; margin-bottom: 12px;">
                          Language: <%= movie.language.charAt(0).toUpperCase() + movie.language.slice(1) %>
                        </p>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2">
                          <a href="/movies/<%= movie._id %>" class="btn btn-sm btn-cinematic flex-grow-1"
                            style="padding: 6px 0;">
                            <i class="bi bi-info-circle me-1"></i> Details
                          </a>
                          <% if (currentuser) { %>
                            <form action="/movies/<%= movie._id %>/watchlist" method="POST" class="m-0">
                              <button class="btn btn-sm btn-cinematic-outline px-2 h-100" style="padding: 6px;"
                                title="Add to watchlist">
                                <i class="bi bi-bookmark-plus text-white"></i>
                              </button>
                            </form>
                            <% } %>
                        </div>
                      </div>
                    </div>

            </div>
          </div>
          <% } %>
      </div>

      <style>
        /* Responsive Movie Grid: 5 cols desktop, 3 tablet, 2 mobile */
        .movie-grid {
          display: grid;
          grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
          gap: 24px;
        }

        @media (max-width: 1200px) {
          .movie-grid {
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
          }
        }

        @media (max-width: 768px) {
          .movie-grid {
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 16px;
          }
        }

        /* Cinematic Movie Card */
        .movie-card-wrapper {
          aspect-ratio: 2 / 3;
          perspective: 1000px;
        }

        .movie-card {
          position: relative;
          width: 100%;
          height: 100%;
          border-radius: var(--radius-lg);
          overflow: hidden;
          background: var(--bg-card);
          transition: all var(--transition-normal);
          box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
          cursor: pointer;
        }

        .movie-card:hover {
          transform: scale(1.05) translateY(-5px);
          box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8), 0 0 15px var(--accent-glow);
          border: 1px solid rgba(255, 255, 255, 0.1);
          z-index: 10;
        }

        /* Poster Image */
        .movie-poster {
          width: 100%;
          height: 100%;
          background-size: cover;
          background-position: center;
          transition: transform var(--transition-slow);
        }

        .no-poster {
          background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-card) 100%);
        }

        .movie-card:hover .movie-poster {
          transform: scale(1.1);
        }

        /* Hover Overlay */
        .movie-overlay {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background: linear-gradient(to bottom,
              rgba(10, 10, 15, 0) 0%,
              rgba(10, 10, 15, 0.4) 40%,
              rgba(10, 10, 15, 0.9) 80%,
              rgba(10, 10, 15, 1) 100%);
          opacity: 0;
          transition: opacity var(--transition-fast);
        }

        .movie-card:hover .movie-overlay {
          opacity: 1;
        }

        /* Slide up animation for content */
        .movie-info-animate {
          transform: translateY(20px);
          transition: transform var(--transition-normal);
        }

        .movie-card:hover .movie-info-animate {
          transform: translateY(0);
        }

        .movie-title {
          font-family: var(--font-heading);
          letter-spacing: 0.5px;
          text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
        }
      </style>

      <script>
        document.addEventListener("DOMContentLoaded", () => {
          // Reveal header
          gsap.fromTo(".gs-reveal",
            { y: 30, opacity: 0 },
            { y: 0, opacity: 1, duration: 1, ease: "power3.out" }
          );
        });
      </script>