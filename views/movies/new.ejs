<% layout("./layouts/boilerplate") %>
<div class="row justify-content-center">
  <div class="col-md-7">
    <h3 class="text-warning mb-4"><i class="bi bi-plus-circle me-2"></i>Add New Movie</h3>
    <form action="/movies" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate>
      <div class="mb-3">
        <label class="form-label">Movie Name *</label>
        <input type="text" name="movie[name]" class="form-control bg-dark text-light border-secondary" required>
        <div class="invalid-feedback">Name is required.</div>
      </div>
      <div class="row g-3 mb-3">
        <div class="col">
          <label class="form-label">Language *</label>
          <select name="movie[language]" class="form-select bg-dark text-light border-secondary" required>
            <% for (let l of languages) { %><option value="<%= l %>"><%= l %></option><% } %>
          </select>
        </div>
        <div class="col">
          <label class="form-label">Genre *</label>
          <select name="movie[genre]" class="form-select bg-dark text-light border-secondary" required>
            <% for (let g of genres) { %><option value="<%= g %>"><%= g %></option><% } %>
          </select>
        </div>
      </div>
      <div class="row g-3 mb-3">
        <div class="col">
          <label class="form-label">Hero</label>
          <input type="text" name="movie[hero]" class="form-control bg-dark text-light border-secondary">
        </div>
        <div class="col">
          <label class="form-label">Heroine</label>
          <input type="text" name="movie[heroine]" class="form-control bg-dark text-light border-secondary">
        </div>
      </div>
      <div class="row g-3 mb-3">
        <div class="col">
          <label class="form-label">Year</label>
          <input type="text" name="movie[year]" class="form-control bg-dark text-light border-secondary" placeholder="e.g. 2023">
        </div>
        <div class="col">
          <label class="form-label">Rating (0–10)</label>
          <input type="number" name="movie[rating]" class="form-control bg-dark text-light border-secondary" min="0" max="10" step="0.1">
        </div>
        <div class="col">
          <label class="form-label">OTT Platform</label>
          <input type="text" name="movie[ott]" class="form-control bg-dark text-light border-secondary" placeholder="e.g. Netflix">
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label">Storyline</label>
        <textarea name="movie[storyline]" class="form-control bg-dark text-light border-secondary" rows="3"></textarea>
      </div>
      <div class="mb-4">
        <label class="form-label">Images</label>
        <input type="file" name="images" class="form-control bg-dark text-light border-secondary" multiple accept="image/*">
      </div>
      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-warning"><i class="bi bi-plus-circle me-1"></i>Add Movie</button>
        <a href="/movies" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
<script>
  (() => {
    const forms = document.querySelectorAll('.needs-validation');
    forms.forEach(f => f.addEventListener('submit', e => {
      if (!f.checkValidity()) { e.preventDefault(); e.stopPropagation(); }
      f.classList.add('was-validated');
    }));
  })();
</script>
