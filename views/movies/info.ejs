<% layout("./layouts/boilerplate") %>

  <!-- Full Bleed Cinematic Details Layout -->
  </div>
  </main>
  <main class="min-vh-100 p-0 m-0 w-100 overflow-hidden" style="background: var(--bg-primary);">

    <!-- Backdrop Section -->
    <div class="movie-backdrop position-relative" style="height: 70vh; min-height: 500px; width: 100%;">
      <% if (movie.images && movie.images.length> 0) { %>
        <!-- Use first image as backdrop -->
        <div class="backdrop-img w-100 h-100"
          style="background-image: url('<%= movie.images[0].url %>'); background-size: cover; background-position: center 20%; filter: brightness(0.7) blur(2px);">
        </div>
        <% } else { %>
          <div class="backdrop-img w-100 h-100"
            style="background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-card) 100%);"></div>
          <% } %>

            <!-- Overlay Gradient to blend with content -->
            <div class="backdrop-overlay position-absolute top-0 start-0 w-100 h-100"
              style="background: linear-gradient(to top, var(--bg-primary) 0%, rgba(10,10,15,0.7) 40%, rgba(10,10,15,0.2) 100%);">
            </div>

            <!-- Hero Content inside backdrop -->
            <div class="container position-absolute bottom-0 start-50 translate-middle-x w-100 pb-5 gs-reveal">
              <div class="row align-items-end">
                <!-- Poster -->
                <div class="col-md-3 d-none d-md-block">
                  <div class="movie-poster-hero shadow-lg"
                    style="border-radius: var(--radius-lg); overflow: hidden; border: 2px solid rgba(255,255,255,0.1); aspect-ratio: 2/3;">
                    <% if (movie.images && movie.images.length> 0) { %>
                      <img src="<%= movie.images[0].url %>" class="w-100 h-100" style="object-fit: cover;"
                        alt="<%= movie.name %>">
                      <% } else { %>
                        <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-secondary">
                          <i class="bi bi-image fs-1 text-muted"></i>
                        </div>
                        <% } %>
                  </div>
                </div>

                <!-- Meta Information -->
                <div class="col-md-9 text-light">
                  <h1 class="cinematic-heading text-white fw-bold mb-2"
                    style="font-size: 3.5rem; text-shadow: 0 4px 15px rgba(0,0,0,0.8);">
                    <%= movie.name %>
                  </h1>

                  <div class="d-flex flex-wrap gap-3 align-items-center mb-4"
                    style="font-family: var(--font-body); font-size: 1rem;">
                    <% if (movie.rating) { %>
                      <span class="d-flex align-items-center text-warning fw-bold"
                        style="background: rgba(0,0,0,0.5); padding: 4px 12px; border-radius: 20px;">
                        <i class="bi bi-star-fill me-2"></i>
                        <%= movie.rating %> / 10
                      </span>
                      <% } %>
                        <span class="text-white-50"><i class="bi bi-calendar me-1"></i>
                          <%= movie.year || 'Unknown Year' %>
                        </span>
                        <span class="tag-pill bg-dark border border-secondary">
                          <%= movie.language.toUpperCase() %>
                        </span>
                        <span class="tag-pill" style="background: var(--accent-primary);">
                          <%= movie.genre %>
                        </span>
                        <span class="text-white-50"><i class="bi bi-display me-1"></i>
                          <%= movie.ott || 'Theaters' %>
                        </span>
                  </div>

                  <!-- Action Buttons -->
                  <div class="d-flex gap-3 flex-wrap">
                    <% if (currentuser) { %>
                      <form action="/movies/<%= movie._id %>/watchlist" method="POST" class="m-0">
                        <button class="btn-cinematic px-4 py-2" title="Add to watchlist">
                          <i class="bi bi-bookmark-plus me-2 fs-5"></i> Watchlist
                        </button>
                      </form>
                      <a href="/movies/<%= movie._id %>/addreview" class="btn-cinematic-outline px-4 py-2">
                        <i class="bi bi-pencil-square me-2 fs-5"></i> Review
                      </a>
                      <% if(currentuser.role==='admin' || currentuser._id.equals(movie.author)) { %>
                        <!-- Assuming some authorization for edit/delete; showing them if user exists for now -->
                        <a href="/movies/<%= movie._id %>/edit" class="btn btn-outline-light px-3 py-2"><i
                            class="bi bi-pencil"></i></a>
                        <form action="/movies/<%= movie._id %>?_method=DELETE" method="POST" class="m-0"
                          onsubmit="return confirm('Delete this movie?')">
                          <button class="btn btn-outline-danger px-3 py-2"><i class="bi bi-trash"></i></button>
                        </form>
                        <% } %>
                          <% } else { %>
                            <a href="/login" class="btn-cinematic px-4 py-2"><i
                                class="bi bi-box-arrow-in-right me-2 fs-5"></i> Login to Add to Watchlist</a>
                            <% } %>
                  </div>
                </div>
              </div>
            </div>
    </div>

    <!-- Details & Comments Section -->
    <div class="container py-5">
      <div class="row g-5">

        <!-- Left Column: Storyline & Cast -->
        <div class="col-lg-7" data-aos="fade-up">
          <div class="glass-panel p-4 mb-4">
            <h3 class="cinematic-heading text-white mb-3" style="font-size: 1.8rem;">Storyline</h3>
            <p class="text-secondary" style="font-size: 1.1rem; line-height: 1.8;">
              <%= movie.storyline ? movie.storyline : "No storyline provided for this movie yet." %>
            </p>
          </div>

          <div class="glass-panel p-4">
            <h3 class="cinematic-heading text-white mb-3" style="font-size: 1.8rem;">Cast & Crew</h3>
            <div class="row g-3">
              <div class="col-sm-6">
                <div class="d-flex align-items-center p-3 rounded"
                  style="background: rgba(255,255,255,0.03); border-left: 3px solid var(--accent-primary);">
                  <i class="bi bi-person-video me-3 fs-3 text-muted"></i>
                  <div>
                    <p class="mb-0 text-white-50 small text-uppercase">Lead Actor</p>
                    <h5 class="mb-0 text-white">
                      <%= movie.hero || 'N/A' %>
                    </h5>
                  </div>
                </div>
              </div>
              <div class="col-sm-6">
                <div class="d-flex align-items-center p-3 rounded"
                  style="background: rgba(255,255,255,0.03); border-left: 3px solid var(--accent-secondary);">
                  <i class="bi bi-person-video me-3 fs-3 text-muted"></i>
                  <div>
                    <p class="mb-0 text-white-50 small text-uppercase">Lead Actress</p>
                    <h5 class="mb-0 text-white">
                      <%= movie.heroine || 'N/A' %>
                    </h5>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Comments & Recommendations -->
        <div class="col-lg-5" data-aos="fade-up" data-aos-delay="200">

          <!-- Comments Section -->
          <div class="glass-panel p-4 mb-4">
            <h4 class="text-white mb-4 d-flex align-items-center" style="font-family: var(--font-heading);">
              <i class="bi bi-chat-left-text me-2 text-warning"></i> Fan Discussion <span
                class="badge bg-secondary ms-2 rounded-pill">
                <%= movie.comments.length %>
              </span>
            </h4>

            <div class="comments-container mb-4 pe-2" style="max-height: 400px; overflow-y: auto;">
              <% if (movie.comments.length===0) { %>
                <div class="text-center py-4">
                  <i class="bi bi-chat-square-dots fs-1 text-muted mb-2 d-block"></i>
                  <p class="text-secondary mb-0">No comments yet. Be the first to discuss!</p>
                </div>
                <% } %>

                  <% for (let comment of movie.comments) { %>
                    <div class="comment-card p-3 mb-3 rounded"
                      style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.05);">
                      <div class="d-flex justify-content-between align-items-start">
                        <div class="d-flex gap-2 align-items-center mb-2">
                          <div
                            class="avatar-circle bg-secondary text-white d-flex align-items-center justify-content-center rounded-circle"
                            style="width: 32px; height: 32px; font-weight: bold;">
                            <%= comment.name.charAt(0).toUpperCase() %>
                          </div>
                          <strong class="text-warning">
                            <%= comment.name %>
                          </strong>
                        </div>

                        <% if (currentuser && currentuser.username===comment.name) { %>
                          <form action="/movies/<%= movie._id %>/comments/<%= comment._id %>?_method=DELETE"
                            method="POST" class="m-0">
                            <button class="btn btn-sm btn-link text-danger p-0" title="Delete comment"><i
                                class="bi bi-trash"></i></button>
                          </form>
                          <% } %>
                      </div>
                      <p class="mb-0 text-light ms-5" style="font-size: 0.95rem; opacity: 0.9;">
                        <%= comment.comment %>
                      </p>
                    </div>
                    <% } %>
            </div>

            <% if (currentuser) { %>
              <form action="/movies/<%= movie._id %>/comments" method="POST" class="mt-3 p-3 rounded"
                style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.1);">
                <input type="hidden" name="comment[name]" value="<%= currentuser.username %>">
                <input type="hidden" name="comment[moviename]" value="<%= movie.name %>">
                <div class="mb-3">
                  <label class="form-label text-white-50 small mb-1">Join the conversation</label>
                  <textarea class="form-control bg-dark text-light border-secondary shadow-none focus-glow"
                    name="comment[comment]" rows="2" placeholder="What did you think of the movie?" required></textarea>
                </div>
                <div class="text-end">
                  <button class="btn btn-cinematic btn-sm px-4"><i class="bi bi-send me-1"></i> Post</button>
                </div>
              </form>
              <% } else { %>
                <div class="text-center p-3 rounded"
                  style="background: rgba(255,255,255,0.02); border: 1px dashed rgba(255,255,255,0.2);">
                  <p class="text-secondary mb-2 small">Want to join the discussion?</p>
                  <a href="/login" class="btn btn-sm btn-outline-light">Login to Comment</a>
                </div>
                <% } %>
          </div>

          <!-- Recommended Movies -->
          <% if (results && results.length> 0) { %>
            <h4 class="text-white mb-3 mt-5" style="font-family: var(--font-heading);">
              <i class="bi bi-collection-play me-2 text-primary"></i> Similar <span class="text-secondary">
                <%= movie.genre %>
              </span> Movies
            </h4>
            <div class="row row-cols-2 g-3">
              <% for (let r of results.slice(0, 4)) { %>
                <div class="col">
                  <a href="/movies/<%= r._id %>" class="text-decoration-none">
                    <div class="card bg-transparent border-0 h-100 movie-rec-card">
                      <div class="rounded overflow-hidden mb-2 position-relative shadow text-center bg-secondary"
                        style="aspect-ratio: 2/3;">
                        <% if (r.images && r.images.length> 0) { %>
                          <img src="<%= r.images[0].url %>" class="w-100 h-100 object-fit-cover" alt="<%= r.name %>">
                          <% } else { %>
                            <i
                              class="bi bi-image fs-1 text-muted position-absolute top-50 start-50 translate-middle"></i>
                            <% } %>
                              <div
                                class="rec-overlay position-absolute w-100 h-100 top-0 start-0 d-flex align-items-center justify-content-center"
                                style="background: rgba(0,0,0,0.6); opacity: 0; transition: opacity 0.3s;">
                                <i class="bi bi-play-circle fs-1 text-white"></i>
                              </div>
                      </div>
                      <h6 class="text-white text-truncate mb-0 fs-6">
                        <%= r.name %>
                      </h6>
                      <p class="text-warning small mb-0"><i class="bi bi-star-fill me-1"></i>
                        <%= r.rating || 'N/A' %>
                      </p>
                    </div>
                  </a>
                </div>
                <% } %>
            </div>
            <% } %>

        </div>
      </div>
    </div>

    <style>
      /* Custom Styles for Details Page */
      .movie-poster-hero {
        transform: translateY(20px);
        transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      }

      .movie-poster-hero:hover {
        transform: translateY(10px);
      }

      .focus-glow:focus {
        border-color: var(--accent-primary) !important;
        box-shadow: 0 0 10px rgba(229, 9, 20, 0.2) !important;
      }

      /* Custom Scrollbar for comments */
      .comments-container::-webkit-scrollbar {
        width: 6px;
      }

      .comments-container::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
      }

      .comments-container::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 10px;
      }

      /* Recommended Movie Cards Hover */
      .movie-rec-card img {
        transition: transform 0.4s ease;
      }

      .movie-rec-card:hover img {
        transform: scale(1.05);
      }

      .movie-rec-card:hover .rec-overlay {
        opacity: 1 !important;
      }

      .movie-rec-card:hover h6 {
        color: var(--accent-primary) !important;
      }
    </style>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        gsap.fromTo(".gs-reveal",
          { y: 50, opacity: 0 },
          { y: 0, opacity: 1, duration: 1, ease: "power3.out", delay: 0.2 }
        );
      });
    </script>

    <main class="min-vh-100">
      <div class="container mt-4 mb-5">