<% layout("./layouts/boilerplate") %>
<div class="row justify-content-center">
  <div class="col-md-7">
    <h3 class="text-warning mb-4"><i class="bi bi-pencil me-2"></i>Edit Movie</h3>
    <form action="/movies/<%= movie._id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate>
      <div class="mb-3">
        <label class="form-label">Movie Name *</label>
        <input type="text" name="movie[name]" class="form-control bg-dark text-light border-secondary" value="<%= movie.name %>" required>
      </div>
      <div class="row g-3 mb-3">
        <div class="col">
          <label class="form-label">Language</label>
          <select name="movie[language]" class="form-select bg-dark text-light border-secondary">
            <% for (let l of languages) { %>
              <option value="<%= l %>" <%= movie.language === l ? 'selected' : '' %>><%= l %></option>
            <% } %>
          </select>
        </div>
        <div class="col">
          <label class="form-label">Genre</label>
          <select name="movie[genre]" class="form-select bg-dark text-light border-secondary">
            <% for (let g of genres) { %>
              <option value="<%= g %>" <%= movie.genre === g ? 'selected' : '' %>><%= g %></option>
            <% } %>
          </select>
        </div>
      </div>
      <div class="row g-3 mb-3">
        <div class="col">
          <label class="form-label">Hero</label>
          <input type="text" name="movie[hero]" class="form-control bg-dark text-light border-secondary" value="<%= movie.hero || '' %>">
        </div>
        <div class="col">
          <label class="form-label">Heroine</label>
          <input type="text" name="movie[heroine]" class="form-control bg-dark text-light border-secondary" value="<%= movie.heroine || '' %>">
        </div>
      </div>
      <div class="row g-3 mb-3">
        <div class="col">
          <label class="form-label">Year</label>
          <input type="text" name="movie[year]" class="form-control bg-dark text-light border-secondary" value="<%= movie.year || '' %>">
        </div>
        <div class="col">
          <label class="form-label">Rating</label>
          <input type="number" name="movie[rating]" class="form-control bg-dark text-light border-secondary" value="<%= movie.rating || '' %>" min="0" max="10" step="0.1">
        </div>
        <div class="col">
          <label class="form-label">OTT</label>
          <input type="text" name="movie[ott]" class="form-control bg-dark text-light border-secondary" value="<%= movie.ott || '' %>">
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label">Storyline</label>
        <textarea name="movie[storyline]" class="form-control bg-dark text-light border-secondary" rows="3"><%= movie.storyline || '' %></textarea>
      </div>

      <!-- Existing images -->
      <% if (movie.images && movie.images.length > 0) { %>
        <div class="mb-3">
          <label class="form-label">Current Images</label>
          <div class="d-flex flex-wrap gap-2">
            <% movie.images.forEach((img, i) => { %>
              <div class="text-center">
                <img src="<%= img.url %>" style="width:80px;height:80px;object-fit:cover" class="rounded border border-secondary mb-1">
                <div class="form-check">
                  <input type="checkbox" class="form-check-input" name="deleteimages[]" value="<%= img.filename %>" id="del-<%= i %>">
                  <label class="form-check-label text-danger small" for="del-<%= i %>">Delete</label>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <div class="mb-4">
        <label class="form-label">Add New Images</label>
        <input type="file" name="images" class="form-control bg-dark text-light border-secondary" multiple accept="image/*">
      </div>
      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Save Changes</button>
        <a href="/movies/<%= movie._id %>" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
<script>
  (() => {
    const forms = document.querySelectorAll('.needs-validation');
    forms.forEach(f => f.addEventListener('submit', e => {
      if (!f.checkValidity()) { e.preventDefault(); e.stopPropagation(); }
      f.classList.add('was-validated');
    }));
  })();
</script>
