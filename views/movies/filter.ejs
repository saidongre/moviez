<% layout("./layouts/boilerplate") %>
<h3 class="text-warning mb-4"><i class="bi bi-funnel me-2"></i>Filter Movies</h3>

<form action="/movies/filter" method="GET" class="row g-3 mb-4">
  <div class="col-md-4">
    <label class="form-label">Genre</label>
    <select name="genre" class="form-select bg-dark text-light border-secondary">
      <option value="none">-- Any Genre --</option>
      <% for (let g of genres) { %>
        <% if (g !== 'none') { %><option value="<%= g %>"><%= g %></option><% } %>
      <% } %>
    </select>
  </div>
  <div class="col-md-4">
    <label class="form-label">Language</label>
    <select name="language" class="form-select bg-dark text-light border-secondary">
      <option value="none">-- Any Language --</option>
      <% for (let l of languages) { %>
        <% if (l !== 'none') { %><option value="<%= l %>"><%= l %></option><% } %>
      <% } %>
    </select>
  </div>
  <div class="col-md-4 d-flex align-items-end">
    <button type="submit" class="btn btn-warning w-100"><i class="bi bi-search me-1"></i>Apply Filter</button>
  </div>
</form>

<% if (movies.length === 0) { %>
  <p class="text-secondary">No movies match your filter.</p>
<% } %>

<div class="row row-cols-1 row-cols-md-3 g-4">
  <% for (let movie of movies) { %>
    <div class="col">
      <div class="card bg-secondary bg-opacity-10 border-secondary h-100">
        <% if (movie.images && movie.images.length > 0) { %>
          <img src="<%= movie.images[0].url %>" class="card-img-top" style="height:180px;object-fit:cover" alt="<%= movie.name %>">
        <% } %>
        <div class="card-body">
          <h6 class="text-warning"><%= movie.name %></h6>
          <p class="text-secondary small mb-1"><%= movie.language %> | <%= movie.genre %></p>
          <% if (movie.rating) { %><p class="small"><i class="bi bi-star-fill text-warning me-1"></i><%= movie.rating %></p><% } %>
        </div>
        <div class="card-footer bg-transparent border-secondary d-flex gap-2">
          <a href="/movies/<%= movie._id %>" class="btn btn-sm btn-warning flex-grow-1">Info</a>
          <% if (currentuser) { %>
            <form action="/movies/<%= movie._id %>/watchlist" method="POST">
              <button class="btn btn-sm btn-outline-warning"><i class="bi bi-bookmark-plus"></i></button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  <% } %>
</div>
